<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Remarks_Required_For_Follow_Up</fullName>
    <active>true</active>
    <description>Require remarks when a sales visit needs follow-up.</description>
    <errorConditionFormula>AND(
    ISPICKVAL(Visit_Outcome__c, &quot;Follow-up Required&quot;),
    ISBLANK(Remarks__c)
)</errorConditionFormula>
    <errorDisplayField>Remarks__c</errorDisplayField>
    <errorMessage>Please enter remarks when Follow-up Required is selected.</errorMessage>
</ValidationRule>
